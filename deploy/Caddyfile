# Caddy en producción: certificado HTTPS automático (Let's Encrypt), cabeceras de seguridad, el panel compilado
# y la API detrás del mismo dominio (/api). Variables en .env: PANEL_DOMINIO y ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

{$PANEL_DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Scripts solo propios (el build no tiene scripts en línea). Los estilos en línea los inserta Angular por
		# componente. blob: = vistas previas de fotos y documentos; i.ytimg.com = portadas de videos de YouTube.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	# La API: mismo origen que el panel (la cookie de sesión funciona sin CORS). El sitio público la llama desde
	# su dominio y la API solo le permite /api/v1/publico (SITIO_ORIGENES).
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# El panel (SPA): cualquier ruta que no sea un archivo devuelve index.html.
	handle {
		root * /srv/panel
		try_files {path} /index.html
		file_server
	}

	# Solo los archivos con hash en el nombre (main-AB12CD34.js) se guardan un año. index.html, el manifiesto y el
	# service worker (ngsw-worker.js, ngsw.json) siempre se revalidan: si no, la versión nueva nunca llegaría.
	@con_hash path_regexp -[A-Za-z0-9]{8}\.(js|css)$
	header @con_hash Cache-Control "public, max-age=31536000, immutable"
	@fuentes path /fuentes/*
	header @fuentes Cache-Control "public, max-age=2592000"
	@revalidar path / /index.html /ngsw-worker.js /ngsw.json /safety-worker.js /manifest.webmanifest
	header @revalidar Cache-Control "no-cache"

	log {
		output stdout
		format json
	}
}
