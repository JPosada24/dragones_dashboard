# Copia este archivo a ".env" y cambia TODOS los valores marcados.
# El archivo .env NO se sube a git (esta en .gitignore).

# Puerto local de la API (cambialo a 8001 solo si el 8000 esta ocupado)
API_PORT=8000

# --- Base de datos (usa solo letras y numeros en la clave para no romper la URL) ---
POSTGRES_USER=dragones
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_LARGA
POSTGRES_DB=dragones

# --- Backend ---
ENTORNO=desarrollo
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_MAS_DE_32_CARACTERES
# Cifra documentos de identidad y archivos. GUARDALA EN UN LUGAR SEGURO: si se pierde, esos datos no se recuperan.
# Genera una con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_FERNET
# En desarrollo (http) debe ser false. En produccion (https) debe ser true.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200
# Sitio público del club (proyecto aparte): solo puede usar /api/v1/publico y sin credenciales.
# En desarrollo el sitio corre con "npm start" en el puerto 4200. Separa varios con comas.
SITIO_ORIGENES=http://localhost:4200
# Dirección del sitio público: el botón «Ver sitio» de Perfil del club la abre (https://…, o localhost en desarrollo).
SITIO_URL=http://localhost:4200

# --- Correo (avisos a familias y staff) ---
# "registro" = no envia nada, solo lo anota en el log (sirve mientras no configures la cuenta).
# "smtp" = envia de verdad. Con Gmail: activa la verificacion en 2 pasos y crea una
# "contrasena de aplicacion" (https://myaccount.google.com/apppasswords). NUNCA pongas tu clave normal.
EMAIL_MODO=registro
CLUB_NOMBRE=Club Dragones
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=correo-del-club@gmail.com
SMTP_PASSWORD=CAMBIA_ESTA_CONTRASENA_DE_APLICACION
SMTP_REMITENTE=Club Dragones <correo-del-club@gmail.com>

# --- Asistente de IA (API de Claude) ---
# Crea la clave en https://platform.claude.com (Settings > API keys). Sin clave, el asistente aparece como
# "no configurado". Cada pregunta tiene costo: el limite diario por usuario se ajusta en Configuracion.
ANTHROPIC_API_KEY=
# AGENTE_MODELO=claude-opus-5-5
# AGENTE_ESFUERZO=medium

# --- Primer SuperAdmin (se crea al arrancar si no existe) ---
SUPERADMIN_EMAIL=admin@dragones.local
SUPERADMIN_NOMBRE=Administrador
# Minimo 12 caracteres con mayuscula, minuscula y numero
SUPERADMIN_PASSWORD=CambiaEstaClave123

# ===================== Solo PRODUCCIÓN (docker-compose.prod.yml) — guía: docs/despliegue.md =====================
# En producción además: ENTORNO=produccion, COOKIE_SECURE=true, CORS_ORIGINS=https://<PANEL_DOMINIO>,
# SITIO_ORIGENES=https://<dominio del sitio> y SITIO_URL=https://<dominio del sitio>.

# Dominio del panel (Caddy saca el certificado HTTPS solo) y correo para los avisos de Let's Encrypt.
PANEL_DOMINIO=panel.ejemplo.com
ACME_EMAIL=correo-del-club@gmail.com

# Rotación de la clave de los tokens: pon aquí la SECRET_KEY anterior durante 15 minutos y luego bórrala.
SECRET_KEY_ANTERIOR=
# Rotación de la clave de cifrado: DATA_ENCRYPTION_KEY={nueva},{vieja} y "python -m app.scripts.rotar_clave".

# --- Copias de seguridad (servicio "respaldo") ---
# Clave PÚBLICA de age (empieza por age1...). La privada NO va en el servidor: guárdala en tu gestor de contraseñas.
# Se generan con:  docker run --rm alpine:3.20 sh -c "apk add -q age && age-keygen"
RESPALDO_AGE_PUBLICA=
RESPALDO_HORA=03:30
# Copia fuera del servidor con rclone (vacío = solo en el servidor). Ej. Backblaze B2 o Cloudflare R2 (S3):
#   RESPALDO_DESTINO=remoto:dragones-respaldos
#   RCLONE_TIPO=s3  RCLONE_PROVEEDOR=Cloudflare  RCLONE_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
RESPALDO_DESTINO=
RCLONE_TIPO=
RCLONE_PROVEEDOR=
RCLONE_ACCESS_KEY_ID=
RCLONE_SECRET_ACCESS_KEY=
RCLONE_ENDPOINT=
# Aviso si una copia falla o no llega (healthchecks.io, gratis): pega la URL de "ping" del chequeo.
RESPALDO_PING_URL=

# --- Monitoreo ---
# Reporte de errores (Sentry o GlitchTip, plan gratuito). Vacío = desactivado. Nunca se envían datos personales.
SENTRY_DSN=
